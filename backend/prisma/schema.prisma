// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(CLIENT)
  googleId     String?   @unique
  avatarUrl    String?
  dateOfBirth  DateTime?
  whatsappPhone String?
  whatsappOptIn Boolean   @default(false)
  whatsappUpdatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  bookingPayments BookingPayment[]
  financeExpenses FinanceExpense[]
  birthdayRewards BirthdayReward[]
}

model Booking {
  id            String   @id @default(uuid())
  calEventId    String   @unique       // UID do booking retornado pelo Cal.com
  userId        String?                // Nullable: visitante pode agendar sem conta
  user          User?    @relation(fields: [userId], references: [id])
  service       String                 // Serviços selecionados (concatenados)
  estimatedValue Float?
  scheduledAt   DateTime
  endTime       DateTime?
  status        String   @default("confirmed")
  notes         String?
  attendeeName  String?
  attendeeEmail String?
  attendeePhone String?
  location      String?               // "presencial" ou link da reunião
  calPayload    Json?                  // Payload bruto do Cal.com para debug
  paymentId     String?  @unique
  payment       BookingPayment? @relation(fields: [paymentId], references: [id])
  serviceCompletedAt DateTime?
  serviceCompletedBy String?
  remainingPaidAt DateTime?
  remainingPaidBy String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BookingPayment {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking           Booking?
  serviceId         String
  serviceName       String
  servicePrice      Float
  paymentType       String
  amount            Float
  minimumAmount     Float
  status            String   @default("pending")
  preferenceId      String?  @unique
  mercadoPagoPaymentId String? @unique
  externalReference String   @unique
  initPoint         String?
  sandboxInitPoint  String?
  scheduledAt       DateTime?
  endTime           DateTime?
  holdExpiresAt     DateTime?
  metadata          Json?
  approvedAt        DateTime?
  remainingPaidAt   DateTime?
  remainingPaidBy   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([scheduledAt])
  @@index([holdExpiresAt])
}

model NotificationLog {
  id                String   @id @default(uuid())
  bookingId         String
  type              String
  target            String
  status            String
  error             String?
  providerMessageId String?  @unique
  providerAck       Int?
  providerAckName   String?
  resolvedTarget    String?
  retryCount        Int      @default(0)
  nextRetryAt       DateTime?
  adminAlertedAt    DateTime?
  createdAt         DateTime @default(now())

  @@unique([bookingId, type, target])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  text      String
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceExpense {
  id          String   @id @default(uuid())
  description String
  category    String   @default("Salao")
  amount      Float
  date        DateTime
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model ScheduleBlock {
  id          String   @id @default(uuid())
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([start])
  @@index([end])
}

model BirthdayReward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  amount    Float    @default(30)
  status    String   @default("pending")
  target    String?
  sentAt    DateTime?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
  @@index([year])
  @@index([status])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(CLIENT)
  googleId     String?   @unique
  whatsappPhone String?
  whatsappOptIn Boolean   @default(false)
  whatsappUpdatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

model Booking {
  id            String   @id @default(uuid())
  calEventId    String   @unique       // UID do booking retornado pelo Cal.com
  userId        String?                // Nullable: visitante pode agendar sem conta
  user          User?    @relation(fields: [userId], references: [id])
  service       String                 // Serviços selecionados (concatenados)
  estimatedValue Float?
  scheduledAt   DateTime
  endTime       DateTime?
  status        String   @default("confirmed")
  notes         String?
  attendeeName  String?
  attendeeEmail String?
  attendeePhone String?
  location      String?               // "presencial" ou link da reunião
  calPayload    Json?                  // Payload bruto do Cal.com para debug
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationLog {
  id        String   @id @default(uuid())
  bookingId String
  type      String
  target    String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@unique([bookingId, type, target])
}
